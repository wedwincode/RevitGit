  <Target Name="ValidateRevit2021Install" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Revit2021InstallDir)\RevitAPI.dll')"
           Text="Revit 2021 API assemblies were not found. Resolved Revit2021InstallDir: $(Revit2021InstallDir). Install Revit 2021 or override Revit2021InstallDir." />
    <Error Condition="!Exists('$(Revit2021InstallDir)\RevitAPIUI.dll')"
           Text="Revit 2021 API assemblies were not found. Resolved Revit2021InstallDir: $(Revit2021InstallDir). Install Revit 2021 or override Revit2021InstallDir." />
    <Error Condition="!Exists('$(Revit2021InstallDir)\Revit.exe')"
           Text="Revit 2021 executable was not found beside the API assemblies. Resolved Revit2021InstallDir: $(Revit2021InstallDir). Verify that the directory is a Revit 2021 installation." />
    <GetAssemblyIdentity AssemblyFiles="$(Revit2021InstallDir)\RevitAPI.dll">
      <Output TaskParameter="Assemblies" ItemName="_RevitApiAssemblyIdentity" />
    </GetAssemblyIdentity>
    <GetAssemblyIdentity AssemblyFiles="$(Revit2021InstallDir)\RevitAPIUI.dll">
      <Output TaskParameter="Assemblies" ItemName="_RevitApiUiAssemblyIdentity" />
    </GetAssemblyIdentity>
    <Error Condition=" '%(_RevitApiAssemblyIdentity.Version)' != '21.0.0.0' "
           Text="The selected RevitAPI.dll is not the Revit 2021 API. Found assembly version %(_RevitApiAssemblyIdentity.Version); expected 21.0.0.0. Resolved Revit2021InstallDir: $(Revit2021InstallDir)." />
    <Error Condition=" '%(_RevitApiUiAssemblyIdentity.Version)' != '21.0.0.0' "
           Text="The selected RevitAPIUI.dll is not the Revit 2021 API. Found assembly version %(_RevitApiUiAssemblyIdentity.Version); expected 21.0.0.0. Resolved Revit2021InstallDir: $(Revit2021InstallDir)." />
  </Target>
